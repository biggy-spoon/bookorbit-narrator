[Unit]
Description=Shutdown listener for sidecar-controlled GPU host sleep
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/gpu-shutdown-listener.env
ExecStart=/usr/bin/python3 /opt/gpu-shutdown-listener/shutdown_listener.py
Restart=on-failure
User=root

[Install]
WantedBy=multi-user.target
