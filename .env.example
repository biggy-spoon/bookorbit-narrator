# BookOrbit instance to watch. Create an API key under Settings -> API Keys with
# library edit-metadata access (needed to add/remove tags) and put it here.
BOOKORBIT_URL=http://bookorbit-app:3000
BOOKORBIT_API_KEY=

# Kokoro-FastAPI (or any OpenAI-compatible TTS server)'s base URL, ending in /v1.
KOKORO_URL=http://kokoro-fastapi:8880/v1

# Default voice ID (see GET {KOKORO_URL}/audio/voices on your Kokoro instance for options).
# Override per book by tagging it "voice:<id>", e.g. voice:af_heart.
DEFAULT_VOICE=af_heart

# Tag lifecycle. Tag a book with TRIGGER_TAG in the BookOrbit dashboard to queue it;
# it's replaced with READY_TAG on success or FAILED_TAG on failure. Re-add TRIGGER_TAG
# to retry a failed book.
TRIGGER_TAG=convert-audio
READY_TAG=audiobook-ready
FAILED_TAG=audiobook-failed

# How often (seconds) to poll BookOrbit for newly tagged books.
POLL_INTERVAL_SECONDS=60

# Maximum characters sent to Kokoro per TTS request. Kokoro-FastAPI handles long
# input, but very long chunks increase latency and failure-retry cost; chunking at
# sentence boundaries keeps individual requests fast and retry-friendly.
MAX_CHARS_PER_REQUEST=1000

# Where to write finished .m4b files. This must be the SAME directory as BookOrbit's
# Book Dock folder (shared Docker volume), e.g. BookOrbit's /data/book-dock.
BOOK_DOCK_PATH=/book-dock

# Local SQLite file tracking per-book conversion state across restarts.
STATE_DB_PATH=/data/state.db
