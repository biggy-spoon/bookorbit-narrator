# BookOrbit instance to watch. Create an API key under Settings -> API Keys with
# library edit-metadata access (needed to add/remove tags) and put it here.
BOOKORBIT_URL=http://bookorbit-app:3000
BOOKORBIT_API_KEY=

# Kokoro-FastAPI (or any OpenAI-compatible TTS server)'s base URL, ending in /v1.
KOKORO_URL=http://kokoro-fastapi:8880/v1

# Default voice ID (see GET {KOKORO_URL}/audio/voices on your Kokoro instance for options).
# Override per book by tagging it "voice:<id>", e.g. voice:af_heart.
DEFAULT_VOICE=af_heart

# Tag lifecycle. Tag a book with TRIGGER_TAG in the BookOrbit dashboard to queue it;
# it's replaced with READY_TAG on success or FAILED_TAG on failure. Re-add TRIGGER_TAG
# to retry a failed book.
TRIGGER_TAG=convert-audio
READY_TAG=audiobook-ready
FAILED_TAG=audiobook-failed

# How often (seconds) to poll BookOrbit for newly tagged books.
POLL_INTERVAL_SECONDS=60

# Maximum characters sent to Kokoro per TTS request. Kokoro-FastAPI handles long
# input, but very long chunks increase latency and failure-retry cost; chunking at
# sentence boundaries keeps individual requests fast and retry-friendly.
MAX_CHARS_PER_REQUEST=1000

# Where to write finished .m4b files. This must be the SAME directory as BookOrbit's
# Book Dock folder (shared Docker volume), e.g. BookOrbit's /data/book-dock.
BOOK_DOCK_PATH=/book-dock

# Local SQLite file tracking per-book conversion state across restarts.
STATE_DB_PATH=/data/state.db

# After a successful conversion, also kick off BookOrbit's native "Generate
# read-aloud books" job (sentence-level forced alignment between the new audio and
# the ebook text, for synced highlighting/seamless reading<->listening in the
# BookOrbit reader). Requires the API key to also have the "Generate read-aloud
# books" permission (which implies "Upload").
GENERATE_READ_ALOUD=true

# BookOrbit's read-aloud job stops at "awaiting_review" and waits for a human to
# check the alignment report before going live, by design. Set true to skip that
# and auto-publish instead. Default is false: alignment runs automatically, but
# you review and click Publish in the dashboard yourself.
AUTO_PUBLISH_READ_ALOUD=false

# How long (seconds) to wait for BookOrbit's Book Dock to import our .m4b and
# attach it to the book before giving up on starting a read-aloud job.
BOOK_DOCK_IMPORT_TIMEOUT_SECONDS=300

# How long (seconds) to wait for a read-aloud alignment job to reach
# awaiting_review/completed before giving up (this doesn't fail the book - the
# audiobook itself already succeeded by this point).
READ_ALOUD_JOB_TIMEOUT_SECONDS=1800

# --- Optional: offload narration to a second, faster (e.g. GPU) Kokoro instance ---
# Everything below is unset by default and is a pure no-op until GPU_KOKORO_URL is
# set - the sidecar then behaves exactly as it does today, using only KOKORO_URL.
#
# When GPU_KOKORO_URL IS set, once per book: optionally send a Wake-on-LAN magic
# packet, then poll GPU_KOKORO_URL until it answers or GPU_WAKE_TIMEOUT_SECONDS
# elapses. If it answers in time, that book is narrated there; otherwise this
# falls back to KOKORO_URL (CPU) for that book, so a sometimes-off GPU machine
# never breaks a conversion, it just doesn't speed that one up.
#
# IMPORTANT about Wake-on-LAN: a magic packet only wakes a sleeping machine if it
# actually reaches that machine's NIC as a genuine Ethernet broadcast - this
# generally means being on the same physical LAN, or having a router/NAS that
# forwards WoL from elsewhere, or a mesh VPN (e.g. Tailscale) with a subnet router
# on that LAN. GPU_WOL_BROADCAST_ADDRESS is just "where this container sends the
# packet" - making it actually arrive is your own network's job, not something
# this project can abstract away. If your GPU machine is never actually asleep
# (or you wake it some other way), just leave GPU_WOL_MAC unset and only set
# GPU_KOKORO_URL.

# e.g. http://100.90.178.55:8880/v1 for a Kokoro-FastAPI GPU instance reachable
# over Tailscale once awake. Leave unset to never use a second backend.
GPU_KOKORO_URL=

# MAC address of the GPU machine's network interface, for the WoL magic packet.
# Leave unset to skip sending WoL (e.g. if you wake it some other way, or it's
# not actually asleep).
GPU_WOL_MAC=

# Where to send the magic packet. 255.255.255.255 only reaches machines on this
# container's own local broadcast domain - override to your LAN's broadcast
# address, a router's WoL-forwarding endpoint, or a relay device's IP as your
# network setup requires.
GPU_WOL_BROADCAST_ADDRESS=255.255.255.255
GPU_WOL_PORT=9

# How long (seconds) to wait for GPU_KOKORO_URL to answer after waking it before
# giving up on this book and falling back to KOKORO_URL, and how often to check.
GPU_WAKE_TIMEOUT_SECONDS=120
GPU_WAKE_POLL_INTERVAL_SECONDS=5
